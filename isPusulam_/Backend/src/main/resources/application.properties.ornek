server.port=8080
server.error.include-message=always

# ---------- VERİTABANI ----------
# pgAdmin'de "isPusulam" adında boş bir veritabanı oluştur, kendi şifreni yaz.
spring.datasource.url=jdbc:postgresql://localhost:5432/isPusulam
spring.datasource.username=postgres
spring.datasource.password=BURAYA_KENDI_SIFRENIZ

# ---------- YAPAY ZEKÂ ----------
# Ücretsiz anahtar: https://console.groq.com > API Keys (gsk_ ile başlar). Anahtarı kimseyle paylaşma.
# OpenAI uyumlu başka bir servis de kullanılabilir; sadece base-url ve model değişir.
# Çalışıyor mu? Backend açıkken: http://localhost:8080/api/ai/durum
ai.api-key=BURAYA_API_ANAHTARI
ai.base-url=https://api.groq.com/openai/v1
ai.model=openai/gpt-oss-120b

# ---------- GİRİŞ TOKEN'I ----------
# En az 20 karakterlik rastgele bir yazı.
uygulama.gizli-anahtar=BURAYA_EN_AZ_20_KARAKTER
